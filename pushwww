#!/bin/bash

ssh -i ~/.ssh/encircle.pem ec2-user@www.example.com 'rm -rf /var/www/html'
scp -i ~/.ssh/encircle.pem -r www ec2-user@www.example.com:/var/www/html

# the symbolic link needs to match the file name in the html file.
# we add a number to the jar name to force browsers to reload the applet.
ssh -i ~/.ssh/encircle.pem ec2-user@www.example.com 'chmod o-rwx -R /var/www; cd /var/www/html; ln -s aoi.jar aoi8888.jar'
./pushjar
