#!/bin/bash

ssh -i ~/.ssh/encircle.pem ubuntu@www.example.com 'rm -rf /var/www'
scp -i ~/.ssh/encircle.pem -r www ubuntu@www.example.com:/var/www

# the symbolic link needs to match the file name in the html file.
# we add a number to the jar name to force browsers to reload the applet.
ssh -i ~/.ssh/encircle.pem ubuntu@www.example.com 'chmod o-rwx -R /var/www; cd /var/www; ln -s aoi.jar aoi8888.jar'
./pushjar
