#!/bin/bash

# get the current time so we can limit the processes
# we kill in the end by their age
STARTTIME=$(date +%s);

# trap ctrl-c and call ctrl_c()
trap ctrl_c INT

function ctrl_c() {
        echo "** Trapped CTRL-C";
}

function cleanup() {
    ENDTIME=$(date +%s);
    LIFETIME=$((ENDTIME-STARTTIME+2));

    if [[ "$(uname)" =~ Darwin ]]
    then
	killall -m spawnais;
	OPTS=;
    else
	killall -r spawnais;
	OPTS=-y"$LIFETIME"s;
    fi

    killall "$OPTS" java;
    killall "$OPTS" make;
    echo "Killed all java and make processes younger than $LIFETIME seconds. Remaining:";
    sleep 1;
    ps -e | grep java;
}

rm -f out/*


make run_gameserv > out/gameserv.out 2>&1 &
make run_matchmaker > out/matchmaker.out 2>&1 &
sleep 3
./spawnais > out/spawnais.out  2>&1 &
make run_client0 | tee out/client0.out 2>&1

# The above code can leave processes runnning so use killall...
# check with "ps -A | grep java"
cleanup