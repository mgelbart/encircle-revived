#!/bin/bash

rm -f out/*

# get the current time so we can limit the processes we kill in the end by their age
STARTTIME=$(date +%s);


make run_serv > out/serv.out 2> out/serv.err &
sleep 3
make run_client1 > out/client1.out 2> out/client1.err &
make run_client0 2>&1 | tee out/client0.out

# The above code can leave processes runnning so use killall...
# check with "ps -A | grep java"

ENDTIME=$(date +%s);
LIFETIME=$((ENDTIME-STARTTIME+2));

if [[ "$(uname)" =~ Darwin ]]
then
	OPTS=;
else
	OPTS=-y"$LIFETIME"s;
fi

killall "$OPTS" java
killall "$OPTS" make
echo "Killed all java and make processes younger than $LIFETIME seconds. Remaining:";
sleep 1;
ps -e | grep java